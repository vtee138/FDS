generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  GUEST  @map("guest")
  MEMBER @map("member")
  ADMIN  @map("admin")
}

model User {
  id           BigInt    @id @default(autoincrement()) @db.BigInt
  email        String    @unique(map: "user_email_key") @db.VarChar(255)
  passwordHash String?   @map("password_hash") @db.VarChar(255)
  // These two fields retain the website's existing registration and Google OAuth data.
  name         String    @db.VarChar(255)
  googleId     String?   @unique(map: "user_google_id_key") @map("google_id") @db.VarChar(255)
  role         Role      @default(GUEST)
  createdAt    DateTime  @default(now()) @map("create_at") @db.Timestamp(3)
  updatedAt    DateTime  @updatedAt @map("update_at") @db.Timestamp(3)
  sessions     Session[]

  @@map("user")
}

model Session {
  id           BigInt   @id @default(autoincrement()) @db.BigInt
  userId       BigInt?  @map("user_id") @db.BigInt
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionToken String   @unique(map: "session_session_token_key") @map("session_token") @db.VarChar(255)
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  userAddress  String   @map("user_address") @db.Text
  expiresAt    DateTime @map("expires_at") @db.Timestamp(3)

  @@index([userId], map: "session_user_id_idx")
  @@index([expiresAt], map: "session_expires_at_idx")
  @@map("session")
}
